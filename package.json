    "@capacitor/filesystem": "^8.1.2",
    "@capacitor/status-bar": "^8.0.3",
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.1.14",
    "@types/crypto-js": "^4.2.2",
    "@vitejs/plugin-react": "^5.0.4",
    "crypto-js": "^4.2.0",
    "des.js": "^1.1.0",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "firebase": "^12.17.1",
    "lucide-react": "^1.31.0",
    "motion": "^12.23.24",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "serverless-http": "^4.0.0",
    "vite": "^6.2.3"
  },
